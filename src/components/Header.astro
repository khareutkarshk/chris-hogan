---
/**
 * Site header — dark (over hero) or light (inner pages)
 */
import { withBase } from '../lib/paths';

interface Props {
	surface?: 'dark' | 'light';
	brand?: string;
}

const { surface = 'dark', brand = 'Chris Hogan' } = Astro.props;

const baseRoot = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
let path = Astro.url.pathname.replace(/\/$/, '') || '/';
if (baseRoot && path.startsWith(baseRoot)) {
	path = path.slice(baseRoot.length) || '/';
}

const navLinks = [
	{ href: '/about', label: 'About' },
	{ href: '/speaking', label: 'Speaking' },
	{ href: '/books', label: 'Books' },
	{ href: '/#contact', label: 'Contact' },
];

const isDark = surface === 'dark';

function isCurrent(href: string) {
	if (href.startsWith('#') || href.includes('#')) return false;
	return path === href;
}
---

<header
	class:list={['site-header', isDark ? 'site-header--dark' : 'site-header--light']}
	x-data="{ open: false }"
	@keydown.escape.window="open = false"
>
	<a class="site-header__wordmark" href={withBase('/')}>{brand}</a>

	<nav class="site-header__links hidden md:flex" aria-label="Primary">
		{
			navLinks.map((link) => (
				<a href={withBase(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>

	<button
		type="button"
		class:list={[
			'site-header__menu-btn md:hidden inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border bg-transparent transition-colors duration-200 focus-visible:outline-none focus-visible:shadow-[var(--focus-ring)]',
			isDark
				? 'border-[var(--border-dark)] text-inverted hover:bg-white/5'
				: 'border-[var(--border-light)] text-primary hover:bg-black/[0.03]',
		]}
		@click="open = !open"
		:aria-expanded="open.toString()"
		aria-controls="mobile-nav"
		aria-label="Toggle navigation"
	>
		<span class="sr-only" x-text="open ? 'Close menu' : 'Open menu'"></span>
		<svg
			x-show="!open"
			class="h-5 w-5"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			aria-hidden="true"
		>
			<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
		</svg>
		<svg
			x-cloak
			x-show="open"
			class="h-5 w-5"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			aria-hidden="true"
		>
			<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
		</svg>
	</button>

	<nav
		id="mobile-nav"
		x-cloak
		x-show="open"
		x-transition:enter="transition ease-out duration-200"
		x-transition:enter-start="opacity-0 -translate-y-1"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-1"
		class:list={[
			'site-header__mobile absolute left-0 right-0 top-[calc(100%+0.5rem)] z-20 rounded-lg border p-3 backdrop-blur-md md:hidden',
			isDark
				? 'border-[var(--border-dark)] bg-[rgba(8,8,8,0.92)]'
				: 'border-[var(--border-light)] bg-[rgba(251,251,253,0.96)]',
		]}
		aria-label="Mobile"
		@click.outside="open = false"
	>
		<ul class="flex flex-col gap-1">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={withBase(link.href)}
							aria-current={isCurrent(link.href) ? 'page' : undefined}
							class:list={[
								'font-heading block rounded-md px-3 py-3 text-[0.9375rem] font-medium tracking-[-0.01em] transition-colors duration-200',
								isDark
									? 'text-inverted/80 hover:bg-white/5 hover:text-inverted'
									: 'text-primary/80 hover:bg-black/[0.03] hover:text-primary',
							]}
							@click="open = false"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.5rem;
	}

	.site-header__wordmark {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.0625rem;
		letter-spacing: -0.03em;
		line-height: 1;
		text-decoration: none;
		transition: color var(--duration-fast) var(--ease-standard);
	}

	/* Wordmark carries the gold identity on every surface */
	.site-header--dark .site-header__wordmark {
		color: var(--color-accent-gold-bright);
	}

	.site-header--dark .site-header__wordmark:hover {
		color: color-mix(in srgb, var(--color-accent-gold-bright) 80%, #fff);
	}

	.site-header--light .site-header__wordmark {
		color: var(--color-accent-gold-ink);
	}

	.site-header--light .site-header__wordmark:hover {
		color: color-mix(in srgb, var(--color-accent-gold-ink) 80%, #000);
	}

	.site-header__links {
		align-items: center;
		gap: 1.75rem;
	}

	.site-header__links a {
		text-decoration: none;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.site-header--dark .site-header__links a {
		color: color-mix(in srgb, #fff 70%, transparent);
	}

	.site-header--dark .site-header__links a:hover,
	.site-header--dark .site-header__links a[aria-current='page'] {
		color: #fff;
	}

	.site-header--light .site-header__links a {
		color: var(--color-text-secondary);
	}

	.site-header--light .site-header__links a:hover,
	.site-header--light .site-header__links a[aria-current='page'] {
		color: var(--color-text-primary);
	}

	@media (min-width: 768px) {
		.site-header__wordmark {
			font-size: 1.125rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__mobile {
			transition: none !important;
		}
	}
</style>
