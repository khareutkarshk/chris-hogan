---
/**
 * PositioningIntro — who he is + portrait
 */
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
	id?: string;
}

const { id = 'about' } = Astro.props;

const statement =
	'Chris Hogan is a two-time national bestselling author, keynote speaker, and leadership coach who built his reputation helping people and organizations execute on retirement, wealth-building, and high-performance leadership — from a championship football career at Georgetown College through more than 16 years as a national Ramsey Solutions personality, and now through Hogan Consulting Group.';
---

<section class="positioning" id={id} aria-labelledby="positioning-title">
	<div class="positioning__inner">
		<div class="positioning__copy">
			<SectionHeader
				id="positioning-title"
				label="About"
				title="Built for stages that demand results."
				as="h2"
			/>
			<p class="positioning__statement">{statement}</p>
			<p class="positioning__mission">
				Mission: educate, encourage, and empower people to do more in retirement,
				leadership, business, and life.
			</p>
			<div class="positioning__actions">
				<Button href="#speaking" variant="ghost" size="md">See speaking topics</Button>
			</div>
		</div>

		<figure class="positioning__media">
			<picture>
				<source srcset="/images/about/chris-portrait.webp" type="image/webp" />
				<img
					src="/images/about/chris-portrait.jpg"
					alt="Portrait of Chris Hogan"
					width="900"
					height="1347"
					loading="lazy"
					decoding="async"
				/>
			</picture>
		</figure>
	</div>
</section>

<style>
	.positioning {
		background: var(--color-base-canvas);
		border-top: 1px solid var(--border-light);
		padding: clamp(3.5rem, 10vw, 6.5rem) 1.25rem;
	}

	.positioning__inner {
		width: min(100%, 72rem);
		margin-inline: auto;
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.positioning__statement {
		margin: 1.75rem 0 0;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: clamp(1.125rem, 2vw, 1.375rem);
		letter-spacing: -0.02em;
		line-height: 1.45;
		color: var(--color-text-primary);
		max-width: 42ch;
	}

	.positioning__mission {
		margin: 1.25rem 0 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 42ch;
	}

	.positioning__actions {
		margin-top: 1.75rem;
	}

	.positioning__media {
		margin: 0;
		width: min(100%, 22rem);
		justify-self: start;
	}

	.positioning__media img {
		width: 100%;
		height: auto;
		object-fit: cover;
		filter: contrast(1.02) saturate(0.94);
	}

	@media (min-width: 900px) {
		.positioning__inner {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 4rem;
		}

		.positioning__media {
			justify-self: end;
			width: min(100%, 26rem);
		}
	}
</style>
