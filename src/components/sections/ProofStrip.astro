---
/**
 * ProofStrip — compact credibility metrics
 * Mobile: 2-col cards. Desktop: 5-col strip.
 * Uses Tailwind utilities so layout survives Astro scoped-CSS / HMR races.
 */
interface Metric {
	value: string;
	label: string;
	labelShort?: string;
}

interface Props {
	metrics?: Metric[];
	id?: string;
}

const {
	id = 'work',
	metrics = [
		{
			value: '2×',
			label: 'National bestselling author',
			labelShort: 'Bestselling author',
		},
		{
			value: '#1',
			label: 'Book in America · Jan 25, 2016 · 68,950 copies (Publishers Weekly)',
			labelShort: 'Book in America · 2016',
		},
		{
			value: '10K+',
			label: 'U.S. millionaires researched',
			labelShort: 'Millionaires researched',
		},
		{
			value: '2008',
			label: 'Georgetown Athletics Hall of Fame',
			labelShort: 'Athletics Hall of Fame',
		},
		{
			value: 'Nashville',
			label: 'Hogan Consulting Group',
			labelShort: 'Hogan Consulting Group',
		},
	],
} = Astro.props;
---

<section
	id={id}
	aria-label="Credibility"
	class="border-t border-[var(--border-light)] bg-[var(--color-surface-mist)] px-4 py-6 md:px-5 md:py-8"
>
	<div class="mx-auto w-full max-w-6xl">
		<ul
			class="m-0 grid list-none grid-cols-2 gap-2.5 p-0 md:gap-3.5 lg:grid-cols-5 lg:gap-3"
		>
			{
				metrics.map((metric, index) => (
					<li
						class:list={[
							'flex flex-col gap-1.5 rounded-[0.625rem] border border-[var(--border-light)] border-t-2 border-t-[var(--gold-rail)] bg-white px-3.5 py-3.5 shadow-[0_1px_2px_rgba(12,23,48,0.04)] md:px-4 md:py-4',
							index === metrics.length - 1 && metrics.length % 2 === 1
								? 'col-span-2 lg:col-span-1'
								: '',
						]}
					>
						<span class="font-heading text-[1.35rem] font-bold leading-tight tracking-[-0.03em] text-[#1d1d1f] md:text-2xl lg:text-[1.375rem]">
							{metric.value}
						</span>
						<span class="hidden font-mono text-[0.625rem] font-medium uppercase leading-snug tracking-[0.04em] text-[var(--color-text-secondary)] md:block md:text-[0.6875rem] lg:text-[0.625rem]">
							{metric.label}
						</span>
						<span class="block font-mono text-[0.625rem] font-medium uppercase leading-snug tracking-[0.04em] text-[var(--color-text-secondary)] md:hidden">
							{metric.labelShort ?? metric.label}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
