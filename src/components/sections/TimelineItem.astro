---
/**
 * TimelineItem — career chronology row
 */
interface Props {
	period: string;
	title: string;
	body?: string;
}

const { period, title, body } = Astro.props;
---

<li class="timeline-item">
	<p class="timeline-item__period text-meta">{period}</p>
	<div class="timeline-item__copy">
		<h3 class="timeline-item__title">{title}</h3>
		{body && <p class="timeline-item__body">{body}</p>}
	</div>
</li>

<style>
	.timeline-item {
		display: grid;
		gap: 0.5rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--border-light);
	}

	.timeline-item:last-child {
		border-bottom: 1px solid var(--border-light);
	}

	.timeline-item__period {
		margin: 0;
		color: #c65d21;
	}

	.timeline-item__title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(1.125rem, 2vw, 1.375rem);
		letter-spacing: -0.025em;
		line-height: 1.25;
		color: #1d1d1f;
	}

	.timeline-item__body {
		margin: 0.45rem 0 0;
		font-size: 0.975rem;
		line-height: 1.6;
		color: #5c5c61;
		max-width: 58ch;
	}

	@media (min-width: 768px) {
		.timeline-item {
			grid-template-columns: 11rem 1fr;
			gap: 1.75rem;
			align-items: start;
			padding: 1.6rem 0;
		}
	}
</style>
