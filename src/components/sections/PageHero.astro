---
/**
 * PageHero — inner-page opener
 * Photo: cinematic band (Speaking). Canvas: editorial (About / Books).
 */
import { withBase } from '../../lib/paths';

interface Props {
	label: string;
	title: string;
	support?: string;
	surface?: 'photo' | 'canvas';
	imageJpg?: string;
	imageWebp?: string;
	imageAlt?: string;
}

const {
	label,
	title,
	support,
	surface = 'canvas',
	imageJpg,
	imageWebp,
	imageAlt = '',
} = Astro.props;

const isPhoto = surface === 'photo';
---

<section
	class:list={['page-hero', isPhoto ? 'page-hero--photo' : 'page-hero--canvas']}
	aria-labelledby="page-hero-title"
>
	{
		isPhoto && imageJpg && (
			<div class="page-hero__media" aria-hidden="true">
				<picture>
					{imageWebp && <source srcset={withBase(imageWebp)} type="image/webp" />}
					<img
						src={withBase(imageJpg)}
						alt=""
						width="2400"
						height="1600"
						decoding="async"
						fetchpriority="high"
					/>
				</picture>
				<div class="page-hero__scrim"></div>
			</div>
		)
	}

	{isPhoto && imageAlt && <span class="sr-only">{imageAlt}</span>}

	<div class="page-hero__inner">
		<p class="page-hero__label">{label}</p>
		<h1 class="page-hero__title" id="page-hero-title">{title}</h1>
		{support && <p class="page-hero__support">{support}</p>}
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		isolation: isolate;
	}

	.page-hero--canvas {
		background: var(--color-base-canvas);
		border-bottom: 1px solid var(--border-light);
		padding: clamp(2.75rem, 8vw, 5rem) 1.25rem 3rem;
	}

	.page-hero--photo {
		min-height: clamp(16rem, 38vw, 22rem);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-base-obsidian);
		color: var(--color-text-inverted);
		padding: clamp(3rem, 8vw, 5rem) 1.25rem 2.5rem;
	}

	.page-hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.page-hero__media picture,
	.page-hero__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
		filter: contrast(1.06) brightness(0.62) saturate(0.85);
	}

	.page-hero__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				105deg,
				rgba(8, 8, 8, 0.88) 0%,
				rgba(8, 8, 8, 0.62) 38%,
				rgba(8, 8, 8, 0.28) 70%
			),
			linear-gradient(to top, rgba(8, 8, 8, 0.55) 0%, transparent 55%);
	}

	.page-hero__inner {
		position: relative;
		z-index: 1;
		width: min(100%, 72rem);
		margin-inline: auto;
		border-left: 3px solid #c65d21;
		padding-left: 1.15rem;
	}

	.page-hero__label {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1;
		color: #c65d21;
	}

	.page-hero__title {
		margin: 0.75rem 0 0;
		max-width: 18ch;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(2rem, 5vw, 3.25rem);
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
	}

	.page-hero--canvas .page-hero__title {
		color: #1d1d1f;
	}

	.page-hero--photo .page-hero__title {
		color: #fff;
	}

	.page-hero__support {
		margin: 0.9rem 0 0;
		max-width: 42ch;
		font-size: 1rem;
		line-height: 1.65;
	}

	.page-hero--canvas .page-hero__support {
		color: #5c5c61;
	}

	.page-hero--photo .page-hero__support {
		color: color-mix(in srgb, #fff 78%, transparent);
	}

	@media (min-width: 768px) {
		.page-hero__inner {
			padding-left: 1.35rem;
		}
	}
</style>
