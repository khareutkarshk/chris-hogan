---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
	title?: string;
	description?: string;
	header?: 'none' | 'light' | 'dark';
	preloadImage?: string;
}

const {
	title = 'Chris Hogan | Author • Speaker • Entrepreneur',
	description = 'Nationally recognized author, speaker, and leadership coach helping people think bigger, lead stronger, and live with purpose.',
	header = 'none',
	preloadImage,
} = Astro.props;

const preloadHref = preloadImage ? withBase(preloadImage) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
		<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
			/>
		</noscript>

		<title>{title}</title>
		{
			preloadHref && (
				<link rel="preload" as="image" href={preloadHref} type="image/webp" fetchpriority="high" />
			)
		}
	</head>
	<body class="bg-canvas font-body text-primary antialiased">
		<a
			href="#main"
			class="text-cta sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-cobalt focus:px-4 focus:py-2 focus:text-inverted"
		>
			Skip to content
		</a>
		{
			header !== 'none' && (
				<div class:list={['site-chrome', header === 'dark' && 'site-chrome--dark']}>
					<div class="site-chrome__inner">
						<Header surface={header} />
					</div>
				</div>
			)
		}
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.site-chrome {
		position: sticky;
		top: 0;
		z-index: 40;
		padding-inline: 1.25rem;
		background: color-mix(in srgb, #fbfbfd 92%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-light);
	}

	.site-chrome--dark {
		background: color-mix(in srgb, #080808 92%, transparent);
		border-bottom-color: var(--border-dark);
	}

	.site-chrome__inner {
		width: min(100%, 72rem);
		margin-inline: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-chrome {
			backdrop-filter: none;
			background: #fbfbfd;
		}

		.site-chrome--dark {
			background: #080808;
		}
	}
</style>
